[Desktop Entry]
Type=Application
Name=KlipperQR
GenericName=Clipboard QR Code Generator
Comment=Turn copied text or links into a QR code
Exec=klipperqr
Icon=io.github.octaviobernal.KlipperQR
Terminal=false
Categories=Utility;Qt;KDE;
Keywords=QR;clipboard;qrcode;
StartupNotify=true
