[Desktop Entry]
Type=Application
Name=KlipperQR
GenericName=Clipboard QR Code Generator
Comment=Make a QR code from copied text
Exec=klipperqr
Icon=io.github.octaviobernal.KlipperQR
Terminal=false
Categories=Utility;Qt;KDE;
Keywords=QR;clipboard;qrcode;
StartupNotify=true
